# Fitness MCP Server - Environment Variables
# Copy this file to .env.local and fill in your values

# Garmin Connect credentials
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your-garmin-password

# Bearer token for MCP auth (any strong random string)
# Leave empty to disable auth (local dev only)
MCP_AUTH_TOKEN=

# Hevy API key (get from https://hevy.com/settings?developer)
HEVY_API_KEY=

# Vercel Blob token (auto-set by Vercel when you add a Blob store)
# Not needed for local development
# BLOB_READ_WRITE_TOKEN=
